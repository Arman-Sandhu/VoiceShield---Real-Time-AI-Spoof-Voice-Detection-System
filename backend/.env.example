# VoiceShield Backend Environment Variables

# Path to the Firebase Service Account JSON file (downloaded from Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# Pretrained Hugging Face Audio Classification Deepfake Detector
HF_MODEL_PATH=MelodyMachine/Deepfake-audio-detection-V2

# Supabase PostgreSQL Configuration (for persistent cloud audit history)
# Note: If Supabase is unreachable or unconfigured, the backend automatically uses the local SQLite database (voiceshield.db)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
